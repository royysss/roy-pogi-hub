-- NOTIFICATION ENGINE
local function scanText(object)
    if object:IsA("TextLabel") or object:IsA("TextButton") then
        local content = object.Text:lower()
        if content:match("take") and content:match("egg") and content:match("safe") and content:match("zone") then
            if _G.SavedLocation then
                local hrp = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    task.wait(0.02)
                    hrp.CFrame = _G.SavedLocation
                end
            end
        end
    end
end

